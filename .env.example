APP_NAME=Kunstbegleiter
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_AT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Lokal SQLite, am Server MariaDB (docs/betrieb.md)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=kunst
# DB_USERNAME=kunst_app
# DB_PASSWORD=

# Am Server: Cache, Session und Queue ueber Redis (Instanz 6380, eigene DB und Praefix, docs/betrieb.md)
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380
REDIS_DB=6
REDIS_CACHE_DB=6
REDIS_PREFIX=kunst_

# Mails (Einladung zur Kopplung ab Etappe 5): am Server echten Versand einrichten
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="kunst@tourtool.app"
MAIL_FROM_NAME="${APP_NAME}"

# Passkeys: Domain, an die Passkeys gebunden sind (Standard: Host aus APP_URL)
# PASSKEYS_RP_ID=art.tourtool.app

# KI, Stimmen, Ort (config/museumguide.php). Schluessel kommen bevorzugt aus Admin > Einstellungen > Zugaenge
# (verschluesselt in der Datenbank); diese Werte sind nur der Rueckfall. "auto" nimmt den Anbieter, fuer den ein
# Schluessel da ist, sonst den Fake.
ANTHROPIC_API_KEY=
GOOGLE_PLACES_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
MUSEUMGUIDE_PLACES=auto
MUSEUMGUIDE_TTS=auto
MUSEUMGUIDE_MONTHLY_LIMIT_CENTS=3000

# Datensicherungen (Seite Admin > Datensicherungen), nur am Server: kunst-prod bzw. kunst-staging
# BACKUP_APP=
