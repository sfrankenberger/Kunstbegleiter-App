#!/usr/bin/env bash
# Musikbett fuer den ausfuehrlichen Guide (docs/konzept.md Abschnitt 16): gemeinfreie Aufnahmen (Musopen,
# United States Air Force Band) von Wikimedia Commons nach storage/app/music/{epoche}/ laden, auf einheitliche
# Lautstaerke bringen (loudnorm) und als 96 kbit MP3 ablegen. Liste: resources/music/manifest.tsv
# (Epoche, Dateiname, URL, Lizenz, Titel). Einmal am Server ausfuehren, dauert einige Minuten:
#   nohup bin/fetch-music > storage/logs/fetch-music.log 2>&1 &
# Schon vorhandene Dateien werden uebersprungen. Eigene Stuecke einfach als MP3 in den Epochen-Ordner legen.
set -euo pipefail
cd "$(dirname "$0")/.."
dir="storage/app/music"
ua="Kunstbegleiter/1.0 (mail@sfrankenberger.com)"
mkdir -p "$dir"

# Einzeldateien der ersten Fassung in die Ordner uebernehmen
for f in "$dir"/*.mp3; do
    [ -f "$f" ] || continue
    name=$(basename "$f" .mp3)
    mkdir -p "$dir/$name"
    mv "$f" "$dir/$name/usaf-$name.mp3"
done

: > "$dir/QUELLEN.md"
echo "Musikbett, geladen mit bin/fetch-music aus resources/music/manifest.tsv (Wikimedia Commons). Lizenz je Datei:" >> "$dir/QUELLEN.md"

while IFS=$'\t' read -r epoche datei url lizenz titel; do
    [ -z "$epoche" ] && continue
    case "$epoche" in \#*) continue ;; esac
    mkdir -p "$dir/$epoche"
    echo "- $epoche/$datei.mp3: $titel ($lizenz)" >> "$dir/QUELLEN.md"
    if [ -s "$dir/$epoche/$datei.mp3" ]; then continue; fi
    tmp="$dir/$epoche/$datei.download"
    echo "lade $epoche/$datei ..."
    if ! curl -fsSL --retry 3 --retry-delay 5 -A "$ua" -o "$tmp" "$url"; then echo "FEHLER beim Laden: $url"; rm -f "$tmp"; continue; fi
    if ffmpeg -nostdin -hide_banner -loglevel error -y -i "$tmp" -t 600 -af "loudnorm=I=-20:TP=-2:LRA=11" -ar 44100 -ac 2 -codec:a libmp3lame -b:a 96k "$dir/$epoche/$datei.mp3"; then
        echo "$epoche/$datei.mp3 fertig"
    else
        echo "FEHLER beim Umrechnen: $datei"; rm -f "$dir/$epoche/$datei.mp3"
    fi
    rm -f "$tmp"
    sleep 1
done < resources/music/manifest.tsv

echo "Musik liegt in $dir"; ls "$dir"
