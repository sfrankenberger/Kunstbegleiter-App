# Queue-Worker fuer Kunstbegleiter (live). Vorlage nach tourtool-queue-*.service, docs/betrieb.md.
# Installieren (als root):
#   cp deploy/kunst-queue.service /etc/systemd/system/kunst-queue.service
#   systemctl daemon-reload && systemctl enable --now kunst-queue
# Staging: Datei kopieren als kunst-staging-queue.service, WorkingDirectory auf art-staging.tourtool.app aendern.
[Unit]
Description=Kunstbegleiter queue worker
After=network.target redis-server.service mariadb.service

[Service]
Type=simple
User=tourtool
Group=psacln
WorkingDirectory=/var/www/vhosts/tourtool.app/art.tourtool.app
ExecStart=/opt/plesk/php/8.5/bin/php artisan queue:work --sleep=2 --tries=3 --max-time=3600 --timeout=300
Restart=always
RestartSec=5
StandardOutput=append:/var/www/vhosts/tourtool.app/art.tourtool.app/storage/logs/queue.log
StandardError=append:/var/www/vhosts/tourtool.app/art.tourtool.app/storage/logs/queue.log

[Install]
WantedBy=multi-user.target
